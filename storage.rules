rules_version = '2';

// Fotos de notas/recibos enviadas para leitura por IA (OCR).
// Apenas usuários autenticados podem enviar/ler dentro do próprio restaurante.
service firebase.storage {
  match /b/{bucket}/o {
    match /restaurants/{restaurantId}/receipts/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Logo da loja: aparece no header pra toda a equipe. Só quem é membro da
    // loja envia/troca (confere memberUids no Firestore); só imagem, até 2 MB.
    match /restaurants/{restaurantId}/logo/{fileName} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/restaurants/$(restaurantId)).data.memberUids;
      allow create, update: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/restaurants/$(restaurantId)).data.memberUids
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp|svg\\+xml)');
    }

    // Imagens do site do cliente (logo, capa, pratos, posts). Leitura pública
    // (aparecem no site); envio só por membro do restaurante (ou no demo).
    match /sites/{restaurantId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && (restaurantId.matches('demo-.*')
            || request.auth.uid in firestore.get(/databases/(default)/documents/restaurants/$(restaurantId)).data.memberUids)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Foto de perfil: qualquer autenticado pode ver (aparece pra outros
    // membros da equipe), só o dono da conta pode enviar/trocar a própria.
    match /avatars/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
