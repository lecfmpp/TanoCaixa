rules_version = '2';

// Regras base: cada restaurante (tenant) só acessa os próprios dados.
// Ajustaremos os caminhos exatos conforme o modelo de dados evoluir.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Documento do restaurante e todas as subcoleções (produtos, despesas,
    // inventários, planejamentos, etc.). Somente membros do restaurante.
    match /restaurants/{restaurantId} {
      function isMember() {
        return isSignedIn()
          && request.auth.uid in resource.data.memberUids;
      }

      allow read: if isMember();
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.memberUids;
      allow update, delete: if isMember();

      match /{document=**} {
        allow read, write: if isSignedIn()
          && request.auth.uid in
             get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.memberUids;
      }
    }

    // Perfil do usuário: só o próprio dono.
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
