rules_version = '2';

// ------------------------------------------------------------------ //
// Tá no Caixa — multi-tenant. Cada restaurante é acessível apenas por seus
// membros (uid presente em memberUids do doc do restaurante). O tenant de
// demonstração fica aberto (dataset de exemplo, sem dados reais).
// O recorte por papel (dono/gerente/…) governa a UI e será reforçado no
// banco numa etapa futura de hardening.
// ------------------------------------------------------------------ //
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function dadosRestaurante(rid) {
      return get(/databases/$(database)/documents/restaurants/$(rid)).data;
    }
    function souMembro(rid) {
      return logado() && (request.auth.uid in dadosRestaurante(rid).memberUids);
    }

    // Perfil do usuário: só o próprio.
    match /users/{userId} {
      allow read, write: if logado() && request.auth.uid == userId;
    }

    // Convites de equipe: só acessados via Cloud Functions (Admin SDK, que
    // ignora estas regras). O cliente nunca lê/escreve aqui direto — evita o
    // problema de "quem ainda não é membro precisa se adicionar ao restaurante".
    match /convites/{token} {
      allow read, write: if false;
    }

    // Tenants de demonstração — abertos (exemplo, sem dados reais). São
    // vários: a matriz e as lojas da rede de demonstração.
    function ehDemo(rid) {
      return rid.matches('demo-.*');
    }

    // Restaurantes reais — só os membros.
    match /restaurants/{rid} {
      allow read, write: if ehDemo(rid);
      allow read: if souMembro(rid);
      allow create: if logado() && (request.auth.uid in request.resource.data.memberUids);
      allow update, delete: if souMembro(rid);

      // Tudo da loja, menos a equipe (regras próprias logo abaixo).
      match /{colecao}/{document=**} {
        allow read, write: if colecao != 'membros' && (ehDemo(rid) || souMembro(rid));
      }

      // Equipe. O papel e o celular de cada um decidem quem manda na loja
      // (e o celular do dono confere o grupo de WhatsApp), então:
      //  - cada pessoa edita o próprio cadastro, mas não o próprio papel nem
      //    o status do convite;
      //  - só o dono (ou o franqueador) mexe no cadastro dos outros;
      //  - quem cria a loja cria o próprio cadastro (como dono/franqueador).
      // Convites entram pelas Cloud Functions (Admin SDK, fora destas regras).
      match /membros/{uid} {
        function papelDe(u) {
          return get(/databases/$(database)/documents/restaurants/$(rid)/membros/$(u)).data.papel;
        }
        function souDonoDaLoja() {
          return logado() && souMembro(rid) && papelDe(request.auth.uid) in ['dono', 'franqueador'];
        }
        function criouALoja() {
          return logado() && dadosRestaurante(rid).criadoPor == request.auth.uid;
        }
        function mexeEmPapel() {
          return request.resource.data.diff(resource.data).affectedKeys().hasAny(['papel', 'conviteStatus']);
        }

        allow read: if ehDemo(rid) || souMembro(rid);
        allow write: if ehDemo(rid);
        allow create: if (request.auth.uid == uid && criouALoja()) || souDonoDaLoja();
        allow update: if (request.auth.uid == uid && souMembro(rid) && !mexeEmPapel()) || souDonoDaLoja();
        allow delete: if (request.auth.uid == uid && souMembro(rid)) || souDonoDaLoja();
      }
    }

    // Sites públicos dos clientes ({sub}.tanocaixa.com.br). Leitura aberta (é o
    // que o site mostra, e o app checa se um endereço está livre); escrita só
    // pela Cloud Function publicarSite, que garante endereço único.
    match /sites/{sub} {
      allow read: if true;
      allow write: if false;
    }

    // Redes (franquia ou várias lojas do mesmo dono) — só o dono da rede.
    // A leitura dos números de cada loja continua governada por memberUids
    // do restaurante, então entrar numa rede não dá acesso a nada sozinho.
    match /redes/{redeId} {
      allow read, write: if redeId.matches('rede-demo.*');
      allow create: if logado() && request.resource.data.donoUid == request.auth.uid;
      allow read, update, delete: if logado() && resource.data.donoUid == request.auth.uid;
    }
  }
}
